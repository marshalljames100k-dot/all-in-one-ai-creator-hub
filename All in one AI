
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101027">
<title>All-in-One AI Creator Hub</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101027;color:#fff;font-family:Arial,sans-serif}
header{padding:22px 18px;background:#191936;position:sticky;top:0;z-index:5}
.brand{font-size:21px;font-weight:bold;color:#a995ff}
header p{font-size:12px;color:#bbb;margin:7px 0 0}
nav{display:flex;gap:17px;overflow:auto;padding-top:17px}
nav a{color:#ddd;text-decoration:none;font-size:13px;white-space:nowrap}
main{max-width:1050px;margin:auto;padding:22px 16px}
.hero{padding:30px 20px;border-radius:20px;background:linear-gradient(135deg,#4934a3,#171b46)}
.hero h1{font-size:32px;margin:0 0 12px}
.hero p{color:#e0dcff;line-height:1.6}
.tag{color:#c6b8ff;font-size:12px;font-weight:bold}
.search{width:100%;padding:15px;border-radius:12px;border:1px solid #444;background:#20203d;color:white;margin:22px 0}
h2{font-size:21px;margin-top:28px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.card{background:#1c1c39;border:1px solid #343456;border-radius:15px;padding:17px;min-height:145px}
.card .emoji{font-size:27px}
.card h3{font-size:16px;margin:12px 0 7px}
.card p{font-size:12px;color:#bbb;line-height:1.5}
.card button,.primary{background:#7658ed;color:white;border:0;padding:11px 14px;border-radius:9px;font-weight:bold}
.card button{font-size:12px}
section{scroll-margin-top:125px}
.info{background:#20203d;padding:20px;border-radius:15px;margin-top:25px;line-height:1.6}
footer{text-align:center;padding:30px;color:#aaa;font-size:12px}
#notice{margin-top:15px;color:#d0c6ff;font-size:13px}
@media(min-width:650px){.grid{grid-template-columns:repeat(3,1fr)}.hero{padding:55px}.hero h1{font-size:43px}}
</style>
</head>
<body>
<header>
  <div class="brand">✦ CREATOR HUB</div>
  <p>Your creative world in one place</p>
  <nav>
    <a href="#home">Home</a>
    <a href="#apps">AI Apps</a>
    <a href="#store">Digital Store</a>
    <a href="#games">Games</a>
    <a href="#about">About</a>
  </nav>
</header>
<main>
<section class="hero" id="home">
  <div class="tag">WELCOME TO YOUR CREATIVE WORLD</div>
  <h1>All Your Creative Tools. One Hub.</h1>
  <p>Create images, videos, music, cartoons and digital products from one mobile-friendly platform.</p>
  <button class="primary" onclick="document.getElementById('apps').scrollIntoView({behavior:'smooth'})">Explore Apps →</button>
</section>

<section id="apps">
<h2>Explore AI Apps</h2>
<input class="search" id="search" placeholder="Search your creative tools..." oninput="filterApps()">
<div class="grid" id="appGrid">
  <article class="card" data-name="image generator">
    <div class="emoji">🎨</div><h3>AI Image Studio</h3>
    <p>Create images and artwork from text prompts.</p>
    <button onclick="openTool('AI Image Studio')">Open tool</button>
  </article>
  <article class="card" data-name="video creator">
    <div class="emoji">🎬</div><h3>AI Video Studio</h3>
    <p>Plan videos, write prompts and create video projects.</p>
    <button onclick="openTool('AI Video Studio')">Open tool</button>
  </article>
  <article class="card" data-name="music generator">
    <div class="emoji">🎵</div><h3>AI Music Studio</h3>
    <p>Write original lyrics and plan music productions.</p>
    <button onclick="openTool('AI Music Studio')">Open tool</button>
  </article>
  <article class="card" data-name="cartoon movie animation">
    <div class="emoji">🐻</div><h3>Cartoon & Movies</h3>
    <p>Develop characters, stories and animation prompts.</p>
    <button onclick="openTool('Cartoon & Movies')">Open tool</button>
  </article>
  <article class="card" data-name="website builder">
    <div class="emoji">🌐</div><h3>Website Builder</h3>
    <p>Plan and build your own websites.</p>
    <button onclick="openTool('Website Builder')">Open tool</button>
  </article>
  <article class="card" data-name="tiktok social video">
    <div class="emoji">📱</div><h3>Social Video Studio</h3>
    <p>Prepare short-form video ideas for social media.</p>
    <button onclick="openTool('Social Video Studio')">Open tool</button>
  </article>
</div>
<p id="notice" aria-live="polite"></p>
</section>

<section id="store">
<h2>Digital Store</h2>
<div class="info">
  <div class="emoji">🛍️</div>
  <h3>Sell Digital Products</h3>
  <p>Plan an online shop for ebooks, templates, music and digital downloads.</p>
  <button class="primary" onclick="openTool('Digital Store')">Explore store</button>
</div>
</section>

<section id="games">
<h2>Games & Entertainment</h2>
<div class="info">
  <div class="emoji">⚽</div>
  <h3>Football Games</h3>
  <p>Your home for football-themed games and entertainment.</p>
  <button class="primary" onclick="openTool('Football Games')">Explore games</button>
</div>
</section>

<section id="about">
<h2>About Creator Hub</h2>
<div class="info">
  One home for your creative projects. Built to work on mobile phones, with a focus on accessible tools and free services.
</div>
</section>
</main>
<footer>© 2026 All-in-One AI Creator Hub. Built for creators.</footer>
<script>
function openTool(name){
 document.getElementById('notice').textContent =
 name + ' is listed in your hub. Its working service will be connected in the next development stage.';
 document.getElementById('notice').scrollIntoView({behavior:'smooth',block:'center'});
}
function filterApps(){
 const q=document.getElementById('search').value.toLowerCase();
 document.querySelectorAll('#appGrid .card').forEach(card=>{
  card.style.display=(card.innerText.toLowerCase()+' '+card.dataset.name).includes(q)?'block':'none';
 });
}
</script>
</body>
</html>
